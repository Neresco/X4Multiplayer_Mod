<?xml version="1.0" encoding="utf-8"?>
<!--
  x4mp custom factions — one unique faction per player (host + each client).

  The vanilla game only has a single "player" faction. In multiplayer every
  connected player must be distinguishable, so we add a dedicated faction per
  slot:
    x4mp_host        -> the server / host player
    x4mp_client_1..8 -> up to 8 connecting clients

  Each is a minimal hidden faction (no economy, no police, no diplomacy) whose
  ships are owned by that player only. Relations are locked so they never drift
  with gameplay; the host keeps its own reputation via the vanilla "player"
  faction (see x4mp.cpp: the host's own ship stays "player" so the game's
  reputation system keeps working; client GHOST ships get these unique ids).
-->
<diff>
  <add sel="/factions">
    <faction id="x4mp_host" name="{90001,1}" description="{90001,2}" shortname="{90001,3}" prefixname="{90001,4}" behaviourset="default" tags="hidden">
      <color ref="faction_player" />
      <icon active="faction_player" inactive="faction_player" />
      <relations locked="1" />
    </faction>
    <faction id="x4mp_client_1" name="{90001,11}" description="{90001,12}" shortname="{90001,13}" prefixname="{90001,14}" behaviourset="default" tags="hidden">
      <color ref="faction_player" />
